# ERP EnterpriseCloud - Backend Environment Variables
PROJECT_NAME="ERP EnterpriseCloud API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Base de Datos PostgreSQL (Amazon RDS o Local)
