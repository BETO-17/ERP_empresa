POSTGRES_PASSWORD=postgres
POSTGRES_DB=erp_enterprisecloud
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_enterprisecloud

# Seguridad y JWT
SECRET_KEY=clave_secreta_super_segura_para_firmar_tokens_jwt_erp_2026
