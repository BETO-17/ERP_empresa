ACCESS_TOKEN_EXPIRE_MINUTES=480

# Almacenamiento Cloud Amazon S3 (Semana 07)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_aws_access_key
AWS_SECRET_ACCESS_KEY=tu_aws_secret_key
