# ERP EnterpriseCloud - Variables de Entorno del Frontend
# Configuración de la API REST de FastAPI
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Modo de datos: 'simulated' (datos mock locales con persistencia) o 'api' (FastAPI real)
VITE_DATA_MODE=simulated

# Entorno de ejecución
VITE_APP_ENV=development
